# ─── Yogya Backend — Environment Variables Template ───
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control!

# ─── Database (Supabase PostgreSQL) ───
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=pdfs

# ─── Cache (Redis / Upstash) ───
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token
# REDIS_URL=redis://localhost:6379  # Use this for local Redis instead of Upstash

# ─── AI Services ───
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Email (Resend) ───
RESEND_API_KEY=your_resend_api_key
ADMIN_EMAIL=your_admin_email
EMAIL_FROM=hello@example.com

# ─── Admin Dashboard ───
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password

# ─── Scraper ───
RUN_SCRAPER_ON_STARTUP=false

# ─── Error Tracking (Sentry) — Phase 4 ───
# SENTRY_DSN=https://your_key@sentry.io/your_project_id

# ─── CORS Allowed Origins (comma-separated) ───
# ALLOWED_ORIGINS=https://yourdomain.com,https://yogya-admin.vercel.app
